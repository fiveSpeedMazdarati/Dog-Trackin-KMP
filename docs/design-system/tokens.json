{
  "$comment": "Dog Trackin' design tokens v0.1 — source of truth for Compose and SwiftUI implementations. See design-system.md.",
  "color": {
    "primitive": {
      "ink": "#000000",
      "paper": "#FFFFFF",
      "lavender": "#D8CCFF",
      "lavenderSoft": "#EFEAFF",
      "sky": "#C6E4FF",
      "skySoft": "#EAF5FF",
      "gray900": "#1A1A1A",
      "gray800": "#2A2A2A",
      "gray600": "#5C5C5C",
      "gray400": "#A3A3A3",
      "gray300": "#C7C7C7"
    },
    "semantic": {
      "light": {
        "backgroundColor": "{primitive.paper}",
        "surface": "{primitive.paper}",
        "onBackground": "{primitive.ink}",
        "textSecondary": "{primitive.gray600}",
        "divider": "{primitive.gray300}",
        "accentPrimary": "{primitive.lavender}",
        "onAccentPrimary": "{primitive.ink}",
        "accentPrimarySoft": "{primitive.lavenderSoft}",
        "accentInfo": "{primitive.sky}",
        "onAccentInfo": "{primitive.ink}",
        "accentInfoSoft": "{primitive.skySoft}",
        "bannerCriticalBackground": "{primitive.ink}",
        "bannerCriticalForeground": "{primitive.paper}",
        "focusRing": "{primitive.ink}"
      },
      "dark": {
        "backgroundColor": "{primitive.ink}",
        "surface": "{primitive.gray900}",
        "onBackground": "{primitive.paper}",
        "textSecondary": "{primitive.gray400}",
        "divider": "{primitive.gray800}",
        "accentPrimary": "{primitive.lavender}",
        "onAccentPrimary": "{primitive.ink}",
        "accentPrimarySoft": "lavender @ 16% over ink",
        "accentInfo": "{primitive.sky}",
        "onAccentInfo": "{primitive.ink}",
        "accentInfoSoft": "sky @ 16% over ink",
        "bannerCriticalBackground": "{primitive.paper}",
        "bannerCriticalForeground": "{primitive.ink}",
        "focusRing": "{primitive.paper}"
      }
    }
  },
  "typography": {
    "$comment": "Sizes are Apple's default (Large) Dynamic Type sizes in pt; platforms scale them.",
    "display":     { "appleStyle": "largeTitle",  "size": 34, "lineHeight": 41, "weight": 700 },
    "title1":      { "appleStyle": "title",       "size": 28, "lineHeight": 34, "weight": 700 },
    "title2":      { "appleStyle": "title2",      "size": 22, "lineHeight": 28, "weight": 600 },
    "title3":      { "appleStyle": "title3",      "size": 20, "lineHeight": 25, "weight": 600 },
    "headline":    { "appleStyle": "headline",    "size": 17, "lineHeight": 22, "weight": 600 },
    "body":        { "appleStyle": "body",        "size": 17, "lineHeight": 22, "weight": 400 },
    "callout":     { "appleStyle": "callout",     "size": 16, "lineHeight": 21, "weight": 400 },
    "subheadline": { "appleStyle": "subheadline", "size": 15, "lineHeight": 20, "weight": 400 },
    "footnote":    { "appleStyle": "footnote",    "size": 13, "lineHeight": 18, "weight": 400 },
    "caption":     { "appleStyle": "caption",     "size": 12, "lineHeight": 16, "weight": 500 }
  },
  "spacing": { "xxs": 2, "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 24, "xxl": 32, "xxxl": 48 },
  "radius": { "small": 8, "medium": 12, "large": 20 },
  "size": { "minTouchTarget": 44, "buttonHeight": 50 }
}
